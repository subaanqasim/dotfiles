# Default fresh-Mac setup. Node is managed by nvm in setup/bootstrap.sh.
tap "oven-sh/bun"
brew "age"
brew "bat"
brew "biome"
brew "eza"
brew "fd"
brew "fzf"
brew "gh"
brew "git"
brew "git-delta"
brew "git-lfs"
brew "gnupg"
brew "go"
brew "jq"
brew "lazygit"
brew "neovim"
brew "pass"
brew "pnpm"
brew "pyenv"
brew "python@3.12"
brew "railway"
brew "ripgrep"
brew "rust"
brew "starship"
brew "stow"
brew "tree-sitter-cli"
brew "wget"
brew "worktrunk"
brew "zoxide"
brew "oven-sh/bun/bun"

# OpenCode v2 uses its official installer, not the v1 Homebrew formula.
cask "codex"
cask "font-geist-mono-nerd-font"
cask "linearmouse"
cask "orbstack"
cask "raycast"
cask "rcmd"
cask "tailscale-app"
cask "visual-studio-code"
cask "wezterm@nightly"
