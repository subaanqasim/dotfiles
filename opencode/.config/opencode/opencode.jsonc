{
  "$schema": "https://opencode.ai/config.json",
  // "model": "anthropic/claude-sonnet-4-5-20250929",
  "share": "manual",
  "update": "auto",
  "formatter": true,

  "agents": {
    // "build": {
    //   // "model": "anthropic/claude-sonnet-4-5-20250929",
    //   "model": "anthropic/claude-opus-4-6-1m",
    // },
    // "plan": {
    //   "model": "anthropic/claude-opus-4-6-1m",
    // },
  },

  "mcp": {
    "servers": {
      "posthog": {
        "type": "remote",
        "disabled": true,
        "url": "https://mcp.posthog.com/mcp",
      },
      "railway": {
        "type": "local",
        "disabled": true,
        "command": ["railway", "mcp"],
      },
      "web-search": {
        "type": "remote",
        "disabled": false,
        "url": "https://search.parallel.ai/mcp",
      },
    },
  },

  "plugins": [
    "./plugins/wakelock",
    // "opencode-chrome-devtools"
  ],

  "lsp": true,

  "providers": {
    "openai": {
      "models": {
        "gpt-6-astra": {
          "limit": {
            "context": 1000000,
            "input": 872000,
            "output": 128000,
          },
        },
        "gpt-6-astra-fast": {
          "limit": {
            "context": 1000000,
            "input": 872000,
            "output": 128000,
          },
        },
        "gpt-6-astra-ultrafast": {
          "limit": {
            "context": 1000000,
            "input": 872000,
            "output": 128000,
          },
        },
      },
    },
    "anthropic": {
      "models": {
        "claude-opus-4-6-1m": {
          "modelID": "claude-opus-4-6",
          "name": "Claude Opus 4.6 [1M]",
          "headers": {
            "anthropic-beta": "context-1m-2025-08-07",
          },
          "limit": {
            "context": 1000000,
            "output": 128000,
          },
        },
      },
    },
  },
  "shell": "zsh",
}
