{
  "$schema": "https://opencode.ai/config.json",
  // "model": "anthropic/claude-sonnet-4-5-20250929",
  "autoshare": false,
  "autoupdate": true,
  "formatter": true,

  "agent": {
    // "build": {
    //   // "model": "anthropic/claude-sonnet-4-5-20250929",
    //   "model": "anthropic/claude-opus-4-6-1m",
    // },
    // "plan": {
    //   "model": "anthropic/claude-opus-4-6-1m",
    // },
  },

  "mcp": {
    "posthog": {
      "type": "remote",
      "enabled": false,
      "url": "https://mcp.posthog.com/mcp",
    },
    "web-search": {
      "type": "remote",
      "enabled": true,
      "url": "https://search.parallel.ai/mcp",
    },
  },

  "plugin": ["opencode-chrome-devtools"],

  "lsp": true,

  "provider": {
    "anthropic": {
      "models": {
        "claude-opus-4-6-1m": {
          "id": "claude-opus-4-6",
          "name": "Claude Opus 4.6 [1M]",
          "headers": {
            "anthropic-beta": "context-1m-2025-08-07",
          },
          "limit": {
            "context": 1000000,
            "output": 128000,
          },
        },
      },
    },
  },
}
