Include ~/.orbstack/ssh/config
Include ~/.ssh/config.local

Host subaanqasim github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/subaanqasim

Host subaan-sh
  HostName ssh.dev.azure.com
  User git
  IdentityFile ~/.ssh/subaan-sh

Host ht ht-db
  User subaan
  HostName api.hifdhtracker.com
  Port 420
  PubKeyAuthentication yes
  IdentityFile ~/.ssh/subaan-ht

Host ht-dev ht-dev-db
  User subaan
  HostName api.dev.hifdhtracker.com
  Port 420
  PubKeyAuthentication yes
  IdentityFile ~/.ssh/subaan-ht

Host ht-db ht-dev-db
  LocalForward 1234 172.18.0.2:5432
  ExitOnForwardFailure yes
  ServerAliveInterval 60
  ServerAliveCountMax 3

Host *
  IdentitiesOnly yes
  AddKeysToAgent yes
  UseKeychain yes
